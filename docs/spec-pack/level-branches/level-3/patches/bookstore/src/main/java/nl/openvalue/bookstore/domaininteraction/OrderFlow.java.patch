+    /**
+     * Cancels an order that has not shipped yet: the order is cancelled before any stock item is read, then the
+     * reserved stock of every line is released in book-id order. A cancellation registers no event.
+     */
+    public void cancelOrder(UUID orderId) {
+        OrderDTO stored = orders.findById(orderId);
+        Order order = translatingDomainExceptions(() -> {
+            Order restored = OrderDomainMapper.toDomain(stored);
+            restored.cancel(clock);
+            return restored;
+        });
+        List<StockItem> released = changeStockOfEveryLine(order, (item, quantity) -> item.release(quantity));
+        saveAndPublish(order, released);
+    }
